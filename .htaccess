# Yellow Cabs Whitecourt - canonical redirects
RewriteEngine On

# 1) /index.html -> /
RewriteCond %{THE_REQUEST} \s/index\.html[\s?] [NC]
RewriteRule ^index\.html$ https://yellowcabswhitecourt.com/ [R=301,L]

# 2) www -> non-www (and https)
RewriteCond %{HTTP_HOST} ^www\.yellowcabswhitecourt\.com$ [NC]
RewriteRule ^(.*)$ https://yellowcabswhitecourt.com/$1 [R=301,L]

# 3) http -> https
RewriteCond %{HTTPS} off
RewriteRule ^(.*)$ https://yellowcabswhitecourt.com/$1 [R=301,L]

# Compression
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json application/ld+json image/svg+xml text/xml application/xml text/plain
</IfModule>

# Browser caching
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>

# Block PDFs - client paperwork must never be served publicly
<FilesMatch "\.(?i:pdf)$">
  Require all denied
</FilesMatch>
